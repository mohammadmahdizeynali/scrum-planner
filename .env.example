# Copy to .env and adjust. On a VPS with a real domain, set DOMAIN to it
# (e.g. planner.example.com) and Caddy will provision HTTPS automatically.

# Local / LAN (plain HTTP): keep ":80" and PLANNER_COOKIE_SECURE=false.
DOMAIN=:80
PLANNER_COOKIE_SECURE=false

# VPS with HTTPS:
# DOMAIN=planner.soophist.ir
# PLANNER_COOKIE_SECURE=true

POSTGRES_USER=planner
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=planner

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-too

# ---- Backups ------------------------------------------------------------
# A ZIP (database + .env + compose files + restore script) is built every
# Saturday 02:00 (admin user's timezone) and also via the Settings button.
# Delivery channels activate when both values of a channel are set; a ZIP is
# always saved to ./backups on the server as well.

# Telegram: token from @BotFather, and your numeric chat id (message the bot,
# then press Start; e.g. via @userinfobot). Needs a server that can reach
# api.telegram.org.
BACKUP_TELEGRAM_BOT_TOKEN=
BACKUP_TELEGRAM_CHAT_ID=

# GitHub: a PRIVATE repo ("owner/name") + a fine-grained token with
# Contents: Read & Write on that repo only. The ZIP lands in backups/ there.
BACKUP_GITHUB_REPO=
BACKUP_GITHUB_TOKEN=

# ---- Daily Telegram briefings ------------------------------------------
# Morning sprint briefing (default 06:00) and evening logged-time summary
# (default 23:00), admin timezone. They reuse BACKUP_TELEGRAM_* credentials
# automatically; set dedicated ones here only if you want a different bot.
NOTIFY_MORNING_HOUR=6
NOTIFY_EVENING_HOUR=23
